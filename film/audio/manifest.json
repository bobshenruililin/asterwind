  {
    "id": "backup-06-00",
    "file": "backup-06-00.mp3",
    "duration": 0.72,
    "text": "There."
  },
  {
    "id": "backup-07-00",
    "file": "backup-07-00.mp3",
    "duration": 1.056,
    "text": "I missed it."
  },
  {
    "id": "backup-08-00",
    "file": "backup-08-00.mp3",
    "duration": 2.208,
    "text": "The test? We can run it again."
  },
  {
    "id": "backup-09-00",
    "file": "backup-09-00.mp3",
    "duration": 1.224,
    "text": "Finishing it."
