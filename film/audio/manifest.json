  {
    "id": "backup-checkin-00",
    "file": "backup-checkin-00.mp3",
    "duration": 3.0,
    "text": "We kept going. I should have checked with you."
  },
  {
    "id": "backup-10-00",
    "file": "backup-10-00.mp3",
    "duration": 3.48,
    "text": "Before we record, let's compare it with your drawing."
  },
  {
    "id": "backup-11-00",
    "file": "backup-11-00.mp3",
    "duration": 2.016,
    "text": "Can we do that together?"
  },
  {
    "id": "backup-12-00",
    "file": "backup-12-00.mp3",
    "duration": 1.872,
    "text": "Yes. Start with the rib."
  },
  {
    "id": "repair-00-00",
    "file": "repair-00-00.mp3",
    "duration": 1.992,
    "text": "Let's splint it. Together."
  },
  {
    "id": "repair-01-00",
    "file": "repair-01-00.mp3",
    "duration": 2.496,
    "text": "Then I need you on the canopy with me."
