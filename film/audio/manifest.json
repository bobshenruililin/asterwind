  {
    "id": "setup-03-00",
    "file": "setup-03-00.mp3",
    "duration": 3.288,
    "text": "I cut the spare at midnight. Forty minutes to fit it."
  },
  {
    "id": "setup-04-00",
    "file": "setup-04-00.mp3",
    "duration": 4.848,
    "text": "My fellowship application closes at noon. This test is the footage I have."
  },
  {
    "id": "setup-05-00",
    "file": "setup-05-00.mp3",
    "duration": 3.864,
    "text": "I know. I just\u2026 wanted to be here when my design moved."
  },
  {
    "id": "setup-06-00",
    "file": "setup-06-00.mp3",
    "duration": 3.864,
    "text": "Hands off at four-thirty. It needs the rest of the night to set."
  },
  {
    "id": "setup-07-00",
    "file": "setup-07-00.mp3",
    "duration": 3.648,
    "text": "We can fit the spare, or spend that time on this seam."
  },
  {
    "id": "backup-00-00",
    "file": "backup-00-00.mp3",
    "duration": 3.144,
    "text": "Use the spare. Julian, do you want a break?"
  },
  {
    "id": "backup-01-00",
    "file": "backup-01-00.mp3",
    "duration": 3.168,
    "text": "Yeah. Just a minute. Keep my drawing here."
  },
  {
    "id": "backup-04-00",
    "file": "backup-04-00.mp3",
    "duration": 1.68,
    "text": "Leave his original here."
